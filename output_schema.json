{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/adguard-output-schema.json",
  "title": "AdGuard Agent Schemas",
  "$defs": {
    "TextSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "user_text",
            "image"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "CanonicalContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_type",
        "extracted_text_segments",
        "image_quality",
        "unclear_regions",
        "is_material_complete"
      ],
      "properties": {
        "input_type": {
          "type": "string",
          "enum": [
            "text",
            "image",
            "image_and_text"
          ]
        },
        "raw_user_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "extracted_text_segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TextSegment"
          }
        },
        "visual_context": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_quality": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "GOOD",
            "PARTIAL",
            "POOR",
            null
          ]
        },
        "unclear_regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "is_material_complete": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "RuleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "rule_name",
        "status",
        "evidence",
        "reason",
        "severity",
        "suggestion",
        "need_human_review"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "enum": [
            "A-01",
            "A-02",
            "A-03",
            "A-04",
            "A-05",
            "A-06",
            "A-07",
            "A-08",
            "A-09",
            "A-10"
          ]
        },
        "rule_name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "RISK",
            "UNCERTAIN"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "severity": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            null
          ]
        },
        "suggestion": {
          "type": [
            "string",
            "null"
          ]
        },
        "need_human_review": {
          "type": "boolean"
        }
      }
    },
    "ReviewTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "model",
        "retry_count",
        "rules_checked",
        "validation_errors",
        "duration_ms"
      ],
      "properties": {
        "request_id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "rules_checked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "validation_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ReviewResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "overall_status",
        "summary",
        "rule_results",
        "need_human_review",
        "uncertain_reasons",
        "trace"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "overall_status": {
          "type": "string",
          "enum": [
            "PASS",
            "RISK",
            "UNCERTAIN"
          ]
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "risk_count",
            "high",
            "medium",
            "low",
            "uncertain_count"
          ],
          "properties": {
            "risk_count": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            },
            "uncertain_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "rule_results": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/RuleResult"
          }
        },
        "need_human_review": {
          "type": "boolean"
        },
        "uncertain_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trace": {
          "$ref": "#/$defs/ReviewTrace"
        }
      }
    },
    "ErrorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}